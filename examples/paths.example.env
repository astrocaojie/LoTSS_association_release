# Copy this file to a local shell snippet and edit the paths for your machine.
# The repository never requires these exact directories.

export LOTSS_ASSOC_OUTPUT_ROOT="$PWD/outputs/lotss_dr3_full"
export LOTSS_ASSOC_DATA_ROOT="$PWD/data/LoTSS_scratch"
export LOTSS_ASSOC_ORIGINAL_DATA_ROOT="$PWD/data/LoTSS_DR3"
export LOTSS_ASSOC_H5_ROOT="$PWD/data/lotss_cutout_2048"
export LOTSS_ASSOC_OFFICIAL_GAUSSIAN_ROOT="$PWD/outputs/lotss_dr3_official_gaussian_catalogs"

export LOTSS_DR1_COMPONENT_CSV="$PWD/data/dr1/lotss_dr1_component_catalogue.csv.gz"
export LOTSS_DR1_COMPONENT_FITS="$PWD/data/dr1/LOFAR_HBA_T1_DR1_merge_ID_v1.2.comp.fits"
export LOTSS_DR1_GAUS_FITS="$PWD/data/dr1/LoLSS_DR1_v1.1.gaus.fits"

# Optional external validation products.
export LOTSS_ASSOC_PARENT_CATALOG="$LOTSS_ASSOC_OUTPUT_ROOT/association/catalogs/final_science_catalogs/parent_host_catalog.parquet"
export LOTSS_ASSOC_LOCAL_CATALOG="$LOTSS_ASSOC_OUTPUT_ROOT/association/catalogs/final_science_catalogs/local_group_catalog.parquet"
export LOTSS_ASSOC_COMPONENT_MATCH_SHARDS="$PWD/data/dr1/crossmatch_parent_external_support/matches/shards"
